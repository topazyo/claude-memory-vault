#!/usr/bin/env bash
# .claude/githooks/pre-commit
#
# Opt-in commit gate that works with any harness, or with none. It runs the
# frontmatter checker and refuses the commit when the checker fails, so a note
# written by an agent whose harness has no post-write hook is still caught
# before it reaches history.
#
# Enable it once per clone, from the vault root:
#   git config core.hooksPath .claude/githooks
#
# Two things to know before you do:
#   - core.hooksPath REPLACES .git/hooks. Any hook already installed there
#     (git-lfs installs several) stops running until you copy it into this
#     folder.
#   - The checker reads the working tree, not the staged snapshot. A bad note
#     you have not staged still blocks the commit; fix it or move it aside.

# Resolve the vault from this hook's own location, and pass it to the checker
# explicitly. An inherited CLAUDE_PROJECT_DIR pointing at some other checkout
# would otherwise make the gate judge the wrong vault.
ROOT="$(cd "$(dirname "$0")/../.." && pwd)"

CLAUDE_PROJECT_DIR="$ROOT" bash "$ROOT/.claude/scripts/vault-check.sh"
rc=$?

# The code is passed through unchanged, and the sentence is chosen to match it.
# The gate used to say "fix the notes it names above" whatever came back, which
# is true only of a violation. For every other code no note was named and often
# nothing was scanned, so that sentence sent the reader looking for a note that
# does not exist. The refusal is the same in all cases, because a commit should
# not go in over a checker that could not run any more than over a bad note.
if [ "$rc" -ne 0 ]; then
  case "$rc" in
    1)  printf 'pre-commit: vault-check exited 1, so the commit was refused. A note violates an invariant. Fix the notes it names above.\n' >&2 ;;
    2)  printf 'pre-commit: vault-check exited 2, so the commit was refused. The checker could not run, so nothing was established about the vault. Its message above says which of the three ways it was, and the usual cause is a wrong root or a wrong working directory rather than anything wrong with a note.\n' >&2 ;;
    64) printf 'pre-commit: vault-check exited 64, so the commit was refused. The checker was called with arguments it does not understand, which is a problem with this hook rather than with the vault.\n' >&2 ;;
    78) printf 'pre-commit: vault-check exited 78, so the commit was refused. A scheduled pass set the tripwire, so nothing was checked at all. Read the tripwire, do what it says, then delete both copies of it before committing.\n' >&2 ;;
    *)  printf 'pre-commit: vault-check exited %s, so the commit was refused. That is not a code this gate knows, which is worth reporting on its own.\n' "$rc" >&2 ;;
  esac
fi
exit "$rc"
